# ==========================================
# PRISM LEARNING PLATFORM ENVIRONMENT VARIABLES
# ==========================================

# BACKEND CONFIGURATION (.env inside /backend)
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key-here-min-32-chars"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway Credentials (Test Keys)
RAZORPAY_KEY_ID="rzp_test_TCtzaWQS6tuDuo"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# FRONTEND CONFIGURATION (.env.local inside /frontend)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
