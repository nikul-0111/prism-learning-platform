# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.production
backend/.env
frontend/.env
frontend/.env.local

# Next.js Build Output
frontend/.next/
frontend/out/
frontend/build/

# Backend Build & Transpilation Output
backend/dist/
backend/build/

# Prisma Generated Client (optional, can be generated on npm install)
backend/src/generated/

# Video Uploads & Media Files (Avoid pushing heavy video binary files)
backend/uploads/videos/raw/*
!backend/uploads/videos/raw/.gitkeep
backend/uploads/videos/hls/*
!backend/uploads/videos/hls/.gitkeep

# System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
